NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api

# DIG live read-only data (server only; never NEXT_PUBLIC)
DIG_DATA_ACCESS=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_CUSTOMER_TABLE_ID=
FEISHU_OPPORTUNITY_TABLE_ID=
# For the explicitly configured internal server only
DIG_ALLOWED_ORIGIN=

# Server-only, read-only PostgreSQL access to existing QCC cache.
# Local development: SSH tunnel binds 127.0.0.1:15433 to the customer-db container.
QCC_DATABASE_URL=
# Backend containing saved real assessments; only GET /api/risk-assessments is used.
QCC_RISK_BASE_URL=

# Optional real admission query; server-only. A submit can incur one provider query.
# Keep off until this application's QCC account and scope have been configured.
DIG_QCC_LIVE_ENABLED=false
DIG_QCC_API_KEY=
DIG_QCC_API_SECRET=
# Licensed public-demand feed: HTTPS URL returning an array of Signal records.
DIG_SIGNAL_FEED_URL=
DIG_SIGNAL_FEED_TOKEN=

# 标杆案例来源（按指定视图筛选）
FEISHU_BENCHMARK_TABLE_ID=tbluCZpHNZ4xwnX7
FEISHU_BENCHMARK_VIEW_ID=vewoTuNZRv
